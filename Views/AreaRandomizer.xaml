<Window x:Class="ProjectSky.Views.AreaRandomizer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Area Randomizer" Width="1050" Height="700"
        WindowStartupLocation="CenterOwner" Background="#202020" Foreground="White">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="AREA RANDOMIZER" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="220"/><ColumnDefinition Width="130"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Randomization" VerticalAlignment="Center"/>
            <ComboBox x:Name="ModeBox" Grid.Column="1" Padding="6" SelectedIndex="0">
                <ComboBoxItem Content="All Areas Together"/>
                <ComboBoxItem Content="Each Area Separately"/>
            </ComboBox>
            <TextBlock Text="Property" Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0"/>
            <ComboBox x:Name="PropertyBox" Grid.Column="3" Padding="6"/>
            <Button Grid.Column="4" Content="Choose Area Folder" Width="170" Height="34" HorizontalAlignment="Right" Click="ChooseFolder_Click"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions>
            <Border Background="#292929" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="FolderText" Text="No folder selected" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <ListBox x:Name="AreaList" Grid.Row="1" Background="#303030" Foreground="White" SelectionMode="Multiple"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="#292929" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="RANDOMIZATION SCOPE" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#D0D0D0" Margin="0,0,0,10">
                        All Areas Together uses one shared pool, so a Pokémon from one area can move to another. Each Area Separately shuffles only within that area's slots and never mixes areas.
                    </TextBlock>
                    <TextBox x:Name="SeedBox" Grid.Row="2" Height="34" VerticalAlignment="Top" Padding="8" Background="#303030" Foreground="White" BorderBrush="#555" ToolTip="Optional numeric seed for reproducible randomization"/>
                    <TextBlock Grid.Row="2" Text="Optional seed" Margin="8,7,0,0" Foreground="#999" IsHitTestVisible="False"/>
                    <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#CFCFCF"/>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Select All" Width="100" Height="38" Margin="0,0,8,0" Click="SelectAll_Click"/>
            <Button Content="Clear" Width="100" Height="38" Margin="0,0,8,0" Click="Clear_Click"/>
            <Button Content="RANDOMIZE SELECTED AREAS" Width="230" Height="38" Click="Randomize_Click"/>
        </StackPanel>
    </Grid>
</Window>
