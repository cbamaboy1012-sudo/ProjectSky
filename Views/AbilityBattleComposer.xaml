<Window x:Class="ProjectSky.Views.AbilityBattleComposer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ability Battle Function Composer"
        Width="1100" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="#202020"
        Foreground="White">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ABILITY BATTLE FUNCTION COMPOSER" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Custom Ability Name" VerticalAlignment="Center"/>
            <TextBox x:Name="AbilityNameBox" Grid.Column="1" Margin="8,0,20,0" Padding="8" Background="#2D2D2D" Foreground="White" BorderBrush="#555" Text="Custom Ability"/>
            <TextBlock Text="Base Ability" Grid.Column="2" VerticalAlignment="Center"/>
            <ComboBox x:Name="BaseAbilityBox" Grid.Column="3" Margin="8,0,0,0" Padding="6" Background="#2D2D2D" Foreground="White"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#282828" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="ADD BATTLE FEATURE" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="1" Text="Source Ability" Margin="0,0,0,5"/>
                    <ComboBox x:Name="SourceAbilityBox" Grid.Row="2" Padding="7" Background="#303030" Foreground="White"/>
                    <TextBlock Grid.Row="3" Text="Feature" Margin="0,12,0,5"/>
                    <ComboBox x:Name="FeatureBox" Grid.Row="4" Padding="7" Background="#303030" Foreground="White" Margin="0,0,0,70"/>
                    <Button Grid.Row="4" Content="ADD FEATURE" Height="42" VerticalAlignment="Bottom" Click="AddFeature_Click" Background="#3A3A3A" Foreground="White"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#282828" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="COMBINED BATTLE FUNCTION" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                    <DataGrid x:Name="ComponentsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Background="#303030" Foreground="White" RowBackground="#303030" AlternatingRowBackground="#363636" BorderBrush="#555">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source Ability" Binding="{Binding SourceAbility}" Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Battle Feature" Binding="{Binding Feature}" Width="180" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Behavior" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Remove" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="X" Click="RemoveFeature_Click" Padding="8,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="SummaryText" Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#CFCFCF"/>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Clear" Width="100" Height="38" Margin="0,0,10,0" Click="Clear_Click"/>
            <Button Content="Export Battle Function JSON" Width="220" Height="38" Click="Export_Click"/>
        </StackPanel>
    </Grid>
</Window>
